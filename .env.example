# Matches docker-compose.yml's postgres service
DATABASE_URL=postgresql://ai_demystifier:ai_demystifier@localhost:5432/ai_demystifier

# Shared secret the GitHub Actions cron sends as the X-Cron-Secret header
# when it calls POST /ingest/run
CRON_SECRET=changeme

# Optional: raises the GitHub Search API rate limit from 10/min (unauthenticated)
# to 30/min. https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Optional: base URL of a local Ollama instance, used by the Demystifier
# pipeline (POST /summarize/run). Defaults to http://localhost:11434 — only
# set this if Ollama runs elsewhere (e.g. a different host/container).
# OLLAMA_HOST=http://localhost:11434
