# Base URL of the FastAPI backend, read server-side only (no NEXT_PUBLIC_ prefix
# needed since /feed is only ever fetched from the Next.js server, not the browser).
BACKEND_API_URL=http://127.0.0.1:8000

# Public URL this site is served at, used for metadataBase (OG tags) and the
# sitemap. Update this to the real domain once deployed.
SITE_URL=http://localhost:3000
